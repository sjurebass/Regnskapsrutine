# Python / uv
.venv/
uv.lock
__pycache__/
*.pyc

# Node
node_modules/

# Personlige Claude-innstillinger (tillatelser)
.claude/settings.local.json

# Diverse
*.new
*.bak
.DS_Store
Thumbs.db

