# Tripletex API-koblingen. Kopieres automatisk til tripletex-api/.env av `npm run set-token`.
# tripletex-api/.env er git-ignorert og skal aldri deles, sjekkes inn eller limes inn i chat.

# API-miljø (test: https://api-test.tripletex.tech/v2)
TRIPLETEX_BASE_URL=https://tripletex.no/v2

# Din personlige nøkkel – legg den inn med `npm run set-token` (skjult inntasting).
# JWT refresh token (starter med "tlxr_") er det vanlige. Typen oppdages automatisk:
# tlxr_-JWT, sessionToken, employeeToken (krever consumer token under) eller annen JWT.
TRIPLETEX_TOKEN=

# Valgfritt: employeeToken + consumerToken i stedet for TRIPLETEX_TOKEN
# (npm run set-token -- employee / npm run set-token -- consumer).
TRIPLETEX_EMPLOYEE_TOKEN=
TRIPLETEX_CONSUMER_TOKEN=

# Valgfritt, bare ved tilgang via flere byråer: én ekstra nøkkel per byrå (npm run set-token -- <navn>).
# Klientene fra alle nøklene slås sammen, og hvert kall går via nøkkelen som har tilgang til klienten.
# TRIPLETEX_TOKEN_<NAVN>=

# Leverandørindeksen (felles for alle klienter). Standard: data/leverandorer.json i repo-rota.
# Relativ sti regnes fra repo-rota.
LEVERANDOR_INDEKS=data/leverandorer.json

# Valgfritt: arbeidsmappe for `npm run mva` (standard %TEMP%\rr\mva-<år>-T<n>\<kunde-id>).
# MVA_ARBEIDSMAPPE=

# Valgfritt: lokal mappe med klientmapper som har klientprofil.md og kjente-avvik.md (mva-flyten).
# Ingen standard – uten denne brukes standardprofilen og kundeinstruksen i Tally.
# AVSTEMMINGER_ROT=
