# Kopier til .env og fyll inn. .env skal ikke deles.
#
# Consumer token: bestilles av Tripletex til integrasjonen (utviklernøkkel).
# Employee token: lages i Tripletex under din bruker i regnskapsførerselskapet,
#   med tilgang til klientene. Ett token dekker alle klienter du har tilgang til –
#   klientbytte skjer ved å sette companyId, ikke ved nye tokens.
#
TRIPLETEX_CONSUMER_TOKEN=
TRIPLETEX_EMPLOYEE_TOKEN=

# Testmiljø: https://api-test.tripletex.tech/v2
TRIPLETEX_BASE=https://tripletex.no/v2
